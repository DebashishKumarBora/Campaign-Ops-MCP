# Campaign Ops settings. Copy this file to .env to change anything.
# Real environment variables (for example from your MCP client config) win over this file.

# Which tools the AI gets: read | propose | execute
CAMPAIGN_OPS_SCOPE=execute

# Approval console port on 127.0.0.1 (0 turns the console off)
CAMPAIGN_OPS_CONSOLE_PORT=4848

# Optional fixed console key (16+ characters). Leave empty to use the generated key in data/console-token.txt
CAMPAIGN_OPS_CONSOLE_TOKEN=

# Emergency stop: 1 refuses every change, whatever the console says
CAMPAIGN_OPS_KILL_SWITCH=0

# Where state lives (defaults to ./data)
CAMPAIGN_OPS_DATA_DIR=

# Use a different policy file (defaults to ./policy.json)
CAMPAIGN_OPS_POLICY_FILE=

# ---------- Google Ads test account (optional) ----------
# npm run gads:setup saves the connection in ~/campaign-ops-secrets/google-ads.json,
# so normally nothing needs to be set here.

# off hides the Google Ads account and uses only the sandbox
CAMPAIGN_OPS_GOOGLE_ADS=

# Folder holding google-ads-key.json and google-ads.json (defaults to ~/campaign-ops-secrets)
CAMPAIGN_OPS_SECRETS_DIR=

# Google Ads API version (defaults to v26)
GOOGLE_ADS_API_VERSION=
